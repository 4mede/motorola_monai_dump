					qcom,supply-post-on-sleep = <0x01>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-max-voltage = <0x1312d0>;
					qcom,supply-min-voltage = <0x1312d0>;
					qcom,supply-name = "dvdd";
					reg = <0x01>;
				};

				qcom,panel-supply-entry@2 {
					qcom,supply-post-off-sleep = <0x01>;
					qcom,supply-post-on-sleep = <0x00>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-max-voltage = <0x2dc6c0>;
					qcom,supply-min-voltage = <0x2dc6c0>;
					qcom,supply-name = "vci";
					reg = <0x02>;
				};
			};

			dsi_panel_pwr_supply_vtdr {
				phandle = <0x198>;
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				qcom,panel-supply-entry@0 {
					qcom,supply-post-on-sleep = <0x01>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-enable-load = <0x7d00>;
					qcom,supply-max-voltage = <0x1b7740>;
					qcom,supply-min-voltage = <0x1b7740>;
					qcom,supply-name = "vddio";
					reg = <0x00>;
				};

				qcom,panel-supply-entry@1 {
					qcom,supply-post-off-sleep = <0x02>;
					qcom,supply-post-on-sleep = <0x01>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-max-voltage = <0x2dc6c0>;
					qcom,supply-min-voltage = <0x2dc6c0>;
					qcom,supply-name = "vci";
					reg = <0x01>;
				};

				qcom,panel-supply-entry@2 {
					qcom,supply-post-off-sleep = <0x02>;
					qcom,supply-post-on-sleep = <0x00>;
					qcom,supply-disable-load = <0x64>;
					qcom,supply-enable-load = <0x186a0>;
					qcom,supply-max-voltage = <0x1312d0>;
					qcom,supply-min-voltage = <0x1312d0>;
					qcom,supply-name = "dvdd";
					reg = <0x02>;
				};
			};

			display_gpio_regulator@1 {
				phandle = <0x199>;
				pinctrl-0 = <0x19a>;
				pinctrl-names = "default";
				proxy-supply = <0x199>;
				regulator-boot-on;
				enable-active-high;
				gpio = <0x16 0x09 0x00>;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-min-microvolt = <0x1b7740>;
				regulator-name = "display_panel_vddio";
				compatible = "qti-regulator-fixed";
			};

			qcom,dsi-display-primary {
				phandle = <0x1a0>;
				qcom,dsi-default-panel = <0x19f>;
				dvdd-supply = <0x8f>;
				vci-supply = <0xffffffff>;
				vddio-supply = <0x199>;
				clock-names = "pll_byte_clk0", "pll_dsi_clk0", "mdp_core_clk";
				clocks = <0xffffffff 0x00 0xffffffff 0x01 0xffffffff 0x38>;
				qcom,demura-panel-id = <0x122e700 0xb0>;
				qcom,mdp = <0xffffffff>;
				qcom,panel-te-source = <0x00>;
				qcom,platform-te-gpio = <0xffffffff 0x63 0x00>;
				pinctrl-1 = <0x19d 0x19e>;
				pinctrl-0 = <0x19b 0x19c>;
				pinctrl-names = "panel_active", "panel_suspend";
				qcom,dsi-phy = <0xffffffff>;
				qcom,dsi-ctrl = <0xffffffff>;
				label = "primary";
				compatible = "qcom,dsi-display";
			};
		};
	};

	fragment@117 {
		phandle = <0x1b1>;
